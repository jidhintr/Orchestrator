### Users API v1. Every request needs the access token from the sign in request below.
### Select the "local" environment (http/http-client.env.json). Run requests top to bottom.

### Sign in (put login and password in http/http-client.private.env.json, which is git-ignored)
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

### List all users
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Create an employee: no departmentIds means the Unassigned department
# @name create
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Asha",
  "lastName": "Rao",
  "email": "asha.rao@example.com",
  "mobile": "9876543210"
}

### Get the user created above (departments, departmentRoles inherited, roles = own extras)
GET {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Put the user into departments (2 = Administratives, 4 = Quality Check); an empty list means Unassigned
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/departments
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "departmentIds": [4, 2]
}

### Give the user an extra role (replaces the user's own roles)
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Manager"]
}

### Update the profile (isActive false deactivates)
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Asha",
  "lastName": "Rao",
  "email": "asha.rao@example.com",
  "mobile": "9876543210",
  "isActive": true
}

### Failure: no token
POST {{baseUrl}}/api/v1/users
Content-Type: application/json

{
  "firstName": "No",
  "lastName": "Actor",
  "mobile": "9876543210"
}

### Failure: invalid body
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "A",
  "lastName": "",
  "email": "not-an-email",
  "mobile": "abc"
}

### Failure: unknown role
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Wizard"]
}

### Failure: unknown department
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/departments
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "departmentIds": [999999]
}

### Failure: duplicate email
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "firstName": "Dup",
  "lastName": "User",
  "email": "ADMIN@orchestrator.local",
  "mobile": "9876543210"
}

### Failure: unknown user
GET {{baseUrl}}/api/v1/users/999999
Authorization: Bearer {{login.response.body.$.accessToken}}

### Set or reset a user's password (managers and above, same rights as editing the user)
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/password
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "password": "a-long-password-123"
}

### Failure: password too short (400)
PUT {{baseUrl}}/api/v1/users/{{create.response.body.$.id}}/password
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "password": "short"
}
