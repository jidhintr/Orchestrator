### Catalogs API v1. Every request needs the access token from the sign in request below.
### Select the "local" environment (http/http-client.env.json). Run requests top to bottom.

### Sign in (put login and password in http/http-client.private.env.json, which is git-ignored)
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "login": "superadmin@orchestrator.local",
  "password": "12345678"
}

### Seeded job type ids: 1 Cutting, 2 Laminating, 3 Quality Assurance, 4 Delivery.

### List all catalogs
GET {{baseUrl}}/api/v1/catalogs
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Create a catalog
# @name create
POST {{baseUrl}}/api/v1/catalogs
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sku": "BAGS-PRINTED",
  "name": "Printed Bags",
  "description": "Printed paper bags",
  "basePrice": 10.5,
  "catalogDiscountPercent": 0,
  "laborCost": 2,
  "commissionPercent": 5,
  "profitPercent": 20,
  "jobTypeIds": [1, 2, 3, 4]
}

### Get the catalog created above
GET {{baseUrl}}/api/v1/catalogs/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Approve it (admins only; 409 when already approved; new and cloned catalogs start unapproved and cannot be ordered)
POST {{baseUrl}}/api/v1/catalogs/{{create.response.body.$.id}}/approve
Authorization: Bearer {{login.response.body.$.accessToken}}

### Create a seasonal catalog in a category (create the category first, see categories.http)
POST {{baseUrl}}/api/v1/catalogs
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sku": "XMAS-GIFT-WRAP",
  "name": "Christmas gift wrap",
  "categoryId": 1000,
  "availableFrom": "2030-11-01",
  "availableTo": "2030-12-31",
  "jobTypeIds": [1, 2]
}

### Reversed availability dates return 400
POST {{baseUrl}}/api/v1/catalogs
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "sku": "BAD-DATES", "name": "Bad dates", "availableFrom": "2030-12-31", "availableTo": "2030-11-01", "jobTypeIds": [1] }

### Approving an unknown catalog returns 404
POST {{baseUrl}}/api/v1/catalogs/999999/approve
Authorization: Bearer {{login.response.body.$.accessToken}}

### Clone it (allowed even when the source has orders; the clone is unapproved and remembers its source in basedOnCatalogId)
# @name clone
POST {{baseUrl}}/api/v1/catalogs/{{create.response.body.$.id}}/clone
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sku": "BAGS-PREMIUM",
  "name": "Premium Bags"
}

### Reorder / add / remove job types on the clone (409 if the catalog has orders)
PUT {{baseUrl}}/api/v1/catalogs/{{clone.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "sku": "BAGS-PREMIUM",
  "name": "Premium Bags",
  "basePrice": 15,
  "catalogDiscountPercent": 0,
  "laborCost": 3,
  "commissionPercent": 5,
  "profitPercent": 25,
  "jobTypeIds": [1, 3, 2, 4]
}

### Deactivate the clone (409 if the catalog has orders)
POST {{baseUrl}}/api/v1/catalogs/{{clone.response.body.$.id}}/deactivate
Authorization: Bearer {{login.response.body.$.accessToken}}

### Activate the clone again
POST {{baseUrl}}/api/v1/catalogs/{{clone.response.body.$.id}}/activate
Authorization: Bearer {{login.response.body.$.accessToken}}
