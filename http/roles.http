### Roles API v1. Every request needs the access token from the sign in request below.
### Select the "local" environment (http/http-client.env.json). Run requests top to bottom.

### Sign in (put login and password in http/http-client.private.env.json, which is git-ignored)
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

### List all roles
GET {{baseUrl}}/api/v1/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Create a role
# @name create
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Estimator",
  "description": "Prepares order estimates"
}

### Get the role created above
GET {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Update the role
PUT {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Estimator",
  "description": "Prepares and revises order estimates"
}

### List the users that have the Admin role (id 2)
GET {{baseUrl}}/api/v1/roles/2/users
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Assign roles to a user (replaces the user's roles; user 2 = seeded admin)
PUT {{baseUrl}}/api/v1/users/2/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Admin", "Estimator"]
}

### Disable the role
POST {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}/disable
Authorization: Bearer {{login.response.body.$.accessToken}}

### Enable the role
POST {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}/enable
Authorization: Bearer {{login.response.body.$.accessToken}}

### Failure: roles still assigned cannot be deleted
DELETE {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### Unassign, then delete the role
PUT {{baseUrl}}/api/v1/users/2/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Admin"]
}

###
DELETE {{baseUrl}}/api/v1/roles/{{create.response.body.$.id}}

### Failure: invalid body
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "x"
}

### Failure: duplicate name
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "admin",
  "description": "Duplicate"
}

### Failure: system role cannot be deleted
DELETE {{baseUrl}}/api/v1/roles/2
Authorization: Bearer {{login.response.body.$.accessToken}}

### Failure: assign an unknown role
PUT {{baseUrl}}/api/v1/users/2/roles
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "roles": ["Wizard"]
}

### Failure: unknown role
GET {{baseUrl}}/api/v1/roles/999999
Authorization: Bearer {{login.response.body.$.accessToken}}
